{
  "entities": {
    "PortfolioSession": {
      "title": "PortfolioSession",
      "description": "A photography session or video reel featured in Heba El-Basyouni's portfolio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "titleAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "mediaType": {
          "type": "string",
          "enum": ["photo", "video"]
        },
        "category": {
          "type": "string",
          "enum": ["weddings", "bridal", "editorial", "family", "reels"]
        },
        "coverImage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600000
        },
        "galleryImages": {
          "type": "array",
          "description": "Up to 10 gallery image URLs or compressed data URLs."
        },
        "videoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "locationAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locationEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sessionDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "storyAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "storyEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cameraSpecs": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "instagramPostUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["portrait", "landscape", "wide"]
        },
        "featured": {
          "type": "boolean"
        },
        "orderIndex": {
          "type": "number"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "titleAr",
        "titleEn",
        "mediaType",
        "category",
        "coverImage",
        "galleryImages",
        "videoUrl",
        "duration",
        "locationAr",
        "locationEn",
        "sessionDate",
        "storyAr",
        "storyEn",
        "cameraSpecs",
        "instagramPostUrl",
        "aspectRatio",
        "featured",
        "orderIndex",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudioProfile": {
      "title": "StudioProfile",
      "description": "Public studio branding and contact links for Heba El-Basyouni.",
      "type": "object",
      "properties": {
        "nameAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "taglineAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taglineEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bioAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "bioEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "studioPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "instagramUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "facebookUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "studioCityAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "studioCityEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "heroImageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "nameAr",
        "nameEn",
        "handle",
        "taglineAr",
        "taglineEn",
        "bioAr",
        "bioEn",
        "studioPhone",
        "instagramUrl",
        "facebookUrl",
        "studioCityAr",
        "studioCityEn",
        "heroImageUrl",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin record keyed by email or UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "addedBy", "createdAt"]
    },
    "BookingInquiry": {
      "title": "BookingInquiry",
      "description": "Client session booking inquiry submitted from the landing page.",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "sessionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "preferredDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 800
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "booked", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["clientName", "clientPhone", "sessionType", "preferredDate", "notes", "status", "createdAt"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/PortfolioSession" },
      "description": "Public photography sessions and video reels curated by the photographer."
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StudioProfile" },
      "description": "Public photographer studio branding, bio, and social/contact links."
    },
    "/adminEmails/{emailId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Allowlisted Google email addresses permitted to access the Admin panel."
    },
    "/bookingInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/BookingInquiry" },
      "description": "Private booking inquiries submitted by prospective clients; readable only by Admins."
    }
  }
}
